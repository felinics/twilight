{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "agentSandbox": {
      "type": "object",
      "properties": {
        "snapshotAfterTurn": {
          "type": "boolean",
          "description": "Whether the owner snapshots the workspace after each turn. Keep false for Agent Sandbox, which does not support snapshots."
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["missingEffects", "maxRedispatches", "redispatchRetry", "orphanProbe"],
      "properties": {
        "missingEffects": {
          "type": "string",
          "enum": ["dispose", "redispatch"],
          "description": "How takeover handles an executing effect missing from the executor. Redispatch may repeat external side effects."
        },
        "maxRedispatches": {
          "type": "integer",
          "minimum": 0
        },
        "redispatchRetry": {
          "type": "string",
          "minLength": 1
        },
        "orphanProbe": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "services": {
      "type": "object",
      "properties": {
        "modelBackend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "enum": [1],
              "description": "model-backend uses process-local state and must run exactly one replica."
            }
          }
        },
        "toolBackend": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "enum": [1],
              "description": "tool-backend owns process-local environment handles and must run exactly one replica."
            }
          }
        }
      }
    }
  }
}
